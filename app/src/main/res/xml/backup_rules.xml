<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup excludes for secrets. Full backup runs on API 31 and below.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="tink_secure_storage.xml"/>
    <exclude domain="sharedpref" path="settings.preferences_pb"/>
    <exclude domain="database" path="."/>
    <exclude domain="file" path="account.json"/>
    <exclude domain="file" path="credentials.json"/>
</full-backup-content>
